generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LEAD
  MEMBER
}

enum CompanyType {
  AUTOMOBILE
  RECYCLING
  MANUFACTURING
  OTHERS
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String          @id @default(uuid())
  email                   String          @unique
  password                String
  name                    String
  role                    UserRole?
  isVerified              Boolean         @default(false) @map("is_verified")
  companyId               String?         @map("company_id")
  company                 Company?        @relation(fields: [companyId], references: [id])
  companyApprovalStatus   ApprovalStatus? @default(PENDING) @map("company_approval_status")
  materials               Material[]
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model Company {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  phone     String?
  address   String?
  type      CompanyType
  users     User[]
  materials Material[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("companies")
}

model Material {
  id          String         @id @default(uuid())
  name        String
  description String?
  quantity    Float
  unit        String
  price       Float?
  status      MaterialStatus @default(PENDING)
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id])
  companyId   String         @map("company_id")
  company     Company        @relation(fields: [companyId], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("materials")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String   // 'verification' or 'reset_password'
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
  @@index([email, type])
}
