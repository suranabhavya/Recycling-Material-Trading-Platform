generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum CompanyType {
  AUTOMOBILE
  RECYCLING
  MANUFACTURING
  OTHERS
}

enum UserType {
  OWNER         // Highest level - full access to everything (Crown icon)
  ADMIN         // Customizable permissions per feature/group (Star icon)
  USER          // Regular employee - sees only assigned content
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialStatus {
  PENDING       // Waiting for approval
  APPROVED      // Approved and listed
  REJECTED      // Rejected by manager
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

// Feature types that admins can have permissions for
enum FeatureType {
  USERS              // User management
  MATERIALS          // Material management
  ORG_CHART          // Organizational chart
  SMART_GROUPS       // Smart groups management
  COMPANY_SETTINGS   // Company settings
}

// Access levels for each feature
enum AccessLevel {
  VIEW          // Can only view
  EDIT          // Can view and edit
  MANAGE        // Can view, edit, and manage settings
  FULL          // Full control including delete
}

// Scope of permission
enum PermissionScope {
  ALL                // Access to all items in the feature
  SMART_GROUP        // Access only to specific smart group
  ORG_UNIT           // Access only to specific org unit
  BRANCH             // Access only to specific branch
  DIRECT_REPORTS     // Access only to direct reports
}

// ============================================
// COMPANY
// ============================================

model Company {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  phone             String?
  address           String?
  type              CompanyType   @default(OTHERS)

  // Business industry information
  industry          String?
  subtype           String?

  // Relations
  users             User[]
  materials         Material[]
  smartGroups       SmartGroup[]
  orgUnits          OrgUnit[]
  roles             Role[]
  branches          Branch[]

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("companies")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  password              String
  name                  String
  phone                 String?
  isVerified            Boolean             @default(false) @map("is_verified")

  // User type in Connecteam model
  userType              UserType            @default(USER) @map("user_type")

  // Company relationship
  companyId             String?             @map("company_id")
  company               Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  joinRequestStatus     JoinRequestStatus?  @default(PENDING) @map("join_request_status")

  // Direct Manager (Core hierarchy mechanism - like Connecteam)
  directManagerId       String?             @map("direct_manager_id")
  directManager         User?               @relation("DirectReports", fields: [directManagerId], references: [id], onDelete: SetNull)
  directReports         User[]              @relation("DirectReports")

  // Role (for grouping and permissions reference)
  roleId                String?             @map("role_id")
  role                  Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Organizational Unit (optional - for org chart visualization)
  orgUnitId             String?             @map("org_unit_id")
  orgUnit               OrgUnit?            @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  // Branch (Connecteam-style location/operational unit)
  branchId              String?             @map("branch_id")
  branch                Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Custom fields (extensible user profile - like Connecteam's custom fields)
  customFields          Json?               @map("custom_fields")

  // Admin permissions (only for ADMIN user type)
  adminPermissions      AdminPermission[]

  // Smart group memberships
  smartGroupMemberships SmartGroupMember[]

  // Materials
  createdMaterials      Material[]          @relation("MaterialCreator")
  materialApprovals     MaterialApproval[]

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([companyId, userType])
  @@index([directManagerId])
  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// ============================================
// ROLES (for grouping, not permissions)
// ============================================

model Role {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  name              String
  description       String?
  color             String?

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             User[]

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@map("roles")
}

// ============================================
// BRANCHES (Connecteam-style locations/operational units)
// ============================================

model Branch {
  id                String      @id @default(uuid())
  companyId         String      @map("company_id")
  name              String
  description       String?

  // Location information
  address           String?
  city              String?
  state             String?
  country           String?
  zipCode           String?     @map("zip_code")

  // Contact information
  phoneNumber       String?     @map("phone_number")
  email             String?

  // Branch manager (optional - can be any user in the branch)
  managerId         String?     @map("manager_id")

  // Metadata for custom fields (hours of operation, branch code, etc.)
  metadata          Json?

  // Is this the main/headquarters branch
  isHeadquarters    Boolean     @default(false) @map("is_headquarters")

  // Active status
  isActive          Boolean     @default(true) @map("is_active")

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             User[]
  materials         Material[]
  adminPermissions  AdminPermission[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@map("branches")
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

model OrgUnit {
  id                String      @id @default(uuid())
  companyId         String      @map("company_id")
  name              String
  parentId          String?     @map("parent_id")
  metadata          Json?

  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent            OrgUnit?    @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          OrgUnit[]   @relation("OrgUnitTree")
  users             User[]

  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("org_units")
}

// ============================================
// SMART GROUPS
// ============================================

model SmartGroup {
  id                String              @id @default(uuid())
  companyId         String              @map("company_id")
  name              String
  description       String?
  criteria          Json?
  isManual          Boolean             @default(false) @map("is_manual")

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members           SmartGroupMember[]
  adminPermissions  AdminPermission[]

  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@map("smart_groups")
}

model SmartGroupMember {
  id            String      @id @default(uuid())
  smartGroupId  String      @map("smart_group_id")
  userId        String      @map("user_id")

  smartGroup    SmartGroup  @relation(fields: [smartGroupId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  addedAt       DateTime    @default(now()) @map("added_at")

  @@unique([smartGroupId, userId])
  @@map("smart_group_members")
}

// ============================================
// ADMIN PERMISSIONS
// ============================================

model AdminPermission {
  id                String            @id @default(uuid())
  adminId           String            @map("admin_id")
  admin             User              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  featureType       FeatureType       @map("feature_type")
  accessLevel       AccessLevel       @map("access_level")
  permissionScope   PermissionScope   @map("permission_scope")

  smartGroupId      String?           @map("smart_group_id")
  smartGroup        SmartGroup?       @relation(fields: [smartGroupId], references: [id], onDelete: Cascade)

  orgUnitId         String?           @map("org_unit_id")

  branchId          String?           @map("branch_id")
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  deepPermissions   Json?             @map("deep_permissions")

  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([adminId])
  @@index([adminId, featureType, permissionScope])
  @@map("admin_permissions")
}

// ============================================
// MATERIALS
// ============================================

model Material {
  id                String              @id @default(uuid())
  name              String
  description       String?
  quantity          Float
  unit              String
  price             Float?
  images            String[]            @default([])
  status            MaterialStatus      @default(PENDING)

  creatorId         String              @map("creator_id")
  creator           User                @relation("MaterialCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  companyId         String              @map("company_id")
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId          String?             @map("branch_id")
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)

  creatorManagerId  String?             @map("creator_manager_id")
  requiresApproval  Boolean             @default(false) @map("requires_approval")
  approvals         MaterialApproval[]
  rejectionReason   String?             @map("rejection_reason")
  finalizedAt       DateTime?           @map("finalized_at")

  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@index([creatorId])
  @@index([creatorManagerId])
  @@index([branchId])
  @@map("materials")
}

model MaterialApproval {
  id                String          @id @default(uuid())
  materialId        String          @map("material_id")
  material          Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)

  approverId        String          @map("approver_id")
  approver          User            @relation(fields: [approverId], references: [id], onDelete: Cascade)

  action            ApprovalAction
  comments          String?

  approvedAt        DateTime        @default(now()) @map("approved_at")

  @@index([materialId])
  @@index([approverId])
  @@map("material_approvals")
}

// ============================================
// AUTHENTICATION
// ============================================

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
  @@index([email, type])
}
